#
# Vercel 容器服务镜像（vercel.json 的 services.server 指向本文件）：
# 只产出 API 进程（/api/*），前端静态资源由 web 服务走 CDN，不进本镜像。
# 与一体化 Dockerfile 的区别：Vercel 构建机没有本地产物，一切从源码构建；
# 无 --web-root（SPA 由 web 服务托管），监听地址/端口交给容器平台（--host 0.0.0.0 + PORT）。

# ── stage 1：JVM 构建（JDK 21 + Gradle wrapper，官方源）─────────────────────
FROM eclipse-temurin:21-jdk AS build
WORKDIR /workspace
# 先复制构建脚本与 wrapper，让依赖解析层可缓存
COPY gradlew gradlew.bat settings.gradle.kts build.gradle.kts gradle.properties ./
COPY gradle ./gradle
# Gradle 发行包源：缺省官方源（Vercel / CI 不传参，零行为变化）。本机在国内构建时
# 可传腾讯云镜像加速：--build-arg GRADLE_DIST_URL=https://mirrors.cloud.tencent.com/gradle/gradle-9.8.1-bin.zip
# （该镜像 zip 的 SHA-256 与官方一致，06-工程约定已核）。镜像 URL 只出现在本机
# 命令行，不进仓库默认值。
ARG GRADLE_DIST_URL=https://services.gradle.org/distributions/gradle-9.8.1-bin.zip
RUN sed -i "s|^distributionUrl=.*|distributionUrl=${GRADLE_DIST_URL}|" gradle/wrapper/gradle-wrapper.properties
# 只产出 API 进程需要的模块（cli 及其依赖闭包）；settings 收录的模块目录必须都在场
COPY ir ./ir
COPY engine-api ./engine-api
COPY engine-jsqlparser ./engine-jsqlparser
COPY engine-calcite ./engine-calcite
COPY engine-antlr ./engine-antlr
COPY engine-jooq ./engine-jooq
COPY lineage ./lineage
COPY graph ./graph
COPY schema ./schema
COPY format ./format
COPY server ./server
COPY cli ./cli
COPY bench ./bench
COPY conformance ./conformance
# installDist 产出可执行发行版（bin/ozml + lib/），不跑测试（测试由 CI 守）
RUN ./gradlew :cli:installDist --no-daemon

# jlink 裁剪运行时：模块清单为实测圈定（jdeps --print-module-deps 被 netty 的
# OSGi manifest 炸掉，推不出来；与一体化 Dockerfile 的 stage 3 同源）。
# 基础镜像必须与 JVM 构建同大版本（都是 temurin 21），jmods 才在场。
RUN jlink \
      --add-modules java.base,java.logging,java.management,java.naming,java.sql,java.xml,jdk.unsupported \
      --strip-debug --no-man-pages --no-header-files --compress=zip-6 \
      --output /javaruntime

# ── stage 2：运行时（jlink 定制 runtime，只带 API 进程）──────────────────────
# 模块清单为实测圈定（jdeps --print-module-deps 被 netty 的 OSGi manifest 炸掉，
# 推不出来；清单与一体化 Dockerfile 的 stage 3 同源）——全部子命令 + SQLite
# 图库 + serve 冒烟跑通过。详见一体化 Dockerfile 同段注释。
FROM ubuntu:22.04
ENV PORT=80 \
    JAVA_HOME=/javaruntime \
    PATH="/javaruntime/bin:${PATH}" \
    LANG=C.UTF-8
WORKDIR /app
COPY --from=build /javaruntime /javaruntime
COPY --from=build /workspace/cli/build/install/ozml/ /app/

EXPOSE 80

ENTRYPOINT ["/app/bin/ozml", "serve", "--host", "0.0.0.0"]
