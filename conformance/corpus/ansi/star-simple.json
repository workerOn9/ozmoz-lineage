{
  "id": "ansi-star-simple",
  "dialect": "ansi",
  "features": [
    "star-expand"
  ],
  "comment": "最简 SELECT * 全表展开",
  "sql": "SELECT * FROM orders",
  "schema": "CREATE TABLE orders (id INT, amount DECIMAL(10,2))",
  "lineage": {
    "edges": [
      {
        "from": "orders.id",
        "to": "id",
        "kind": "OUTPUT"
      },
      {
        "from": "orders.amount",
        "to": "amount",
        "kind": "OUTPUT"
      },
      {
        "from": "orders",
        "to": "id",
        "kind": "SOURCE"
      },
      {
        "from": "orders",
        "to": "amount",
        "kind": "SOURCE"
      }
    ]
  }
}
