{
  "id": "ansi-subquery-derived",
  "dialect": "ansi",
  "features": [
    "subquery",
    "derived-table",
    "aggregate"
  ],
  "comment": "派生表（FROM 子查询）",
  "sql": "SELECT d.user_id, d.total FROM (SELECT user_id, SUM(amount) AS total FROM payments GROUP BY user_id) d",
  "lineage": {
    "edges": [
      {
        "from": "d.user_id",
        "to": "user_id",
        "kind": "OUTPUT"
      },
      {
        "from": "d.total",
        "to": "total",
        "kind": "OUTPUT"
      },
      {
        "from": "payments.user_id",
        "to": "d.user_id",
        "kind": "OUTPUT"
      },
      {
        "from": "payments.amount",
        "to": "d.total",
        "kind": "OUTPUT"
      },
      {
        "from": "payments.user_id",
        "to": "d.user_id",
        "kind": "GROUP_BY"
      },
      {
        "from": "payments.user_id",
        "to": "d.total",
        "kind": "GROUP_BY"
      },
      {
        "from": "payments",
        "to": "d.user_id",
        "kind": "SOURCE"
      },
      {
        "from": "payments",
        "to": "d.total",
        "kind": "SOURCE"
      }
    ]
  }
}
