        "kind": "OUTPUT"
      },
      {
        "from": "emp.salary",
        "to": "rn",
        "kind": "OUTPUT"
      },
      {
        "from": "emp",
        "to": "id",
        "kind": "SOURCE"
      },
      {
        "from": "emp",
        "to": "rn",
        "kind": "SOURCE"
      }
    ]
  }
